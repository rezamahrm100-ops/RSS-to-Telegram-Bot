{
  "openapi": "3.1.0",
  "info": {
    "title": "Khabarchin RSStT Control API",
    "version": "0.3.0",
    "description": "Owner-only localhost REST Control API: read status/feeds/subscriptions/rules/reviews, opt-in native subscription lifecycle and deterministic per-subscription settings. Writes are disabled by default; strict channel allowlist, live RSStT Unix IPC. No generic shell, SQL, filesystem or Telegram publishing."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8766",
      "description": "Same VPS loopback only; no public gateway"
    }
  ],
  "security": [
    {
      "vpsLocalBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "vpsLocalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Random VPS-local token stored in a restricted file; never in GitHub/Actions artifacts"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "RulePatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "review"
            ]
          },
          "deduplicate": {
            "type": "boolean"
          },
          "include": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "exclude": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "NativeSubscriptionCommand": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "url"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "subscribe"
                ]
              },
              "channel_id": {
                "type": "integer"
              },
              "url": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1024
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "unsubscribe",
                  "activate",
                  "deactivate"
                ]
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id",
              "value"
            ],
            "properties": {
              "action": {
                "const": "set_title"
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "description": "No control characters"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id",
              "value"
            ],
            "properties": {
              "action": {
                "const": "set_hashtags"
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "No control characters"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id",
              "value"
            ],
            "properties": {
              "action": {
                "const": "set_interval"
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id",
              "value"
            ],
            "properties": {
              "action": {
                "const": "set_length_limit"
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "anyOf": [
                  {
                    "const": -100
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "channel_id",
              "subscription_id",
              "field",
              "value"
            ],
            "properties": {
              "action": {
                "const": "set_option"
              },
              "channel_id": {
                "type": "integer"
              },
              "subscription_id": {
                "type": "integer",
                "minimum": 1
              },
              "field": {
                "type": "string",
                "enum": [
                  "notify",
                  "send_mode",
                  "link_preview",
                  "display_media",
                  "display_author",
                  "display_via",
                  "display_title",
                  "display_entry_tags",
                  "style"
                ]
              },
              "value": {
                "type": "integer"
              }
            },
            "description": "See x-khabarchin-enum-values (each option also accepts -100=inherit)."
          }
        ],
        "x-khabarchin-enum-values": {
          "notify": [
            -100,
            1,
            0
          ],
          "send_mode": [
            -100,
            0,
            1,
            2,
            -1
          ],
          "link_preview": [
            -100,
            0,
            1,
            -1
          ],
          "display_media": [
            -100,
            0,
            1,
            -1
          ],
          "display_author": [
            -100,
            0,
            1,
            -1
          ],
          "display_via": [
            -100,
            0,
            1,
            -3,
            -1,
            -4,
            -2
          ],
          "display_title": [
            -100,
            0,
            1,
            -1
          ],
          "display_entry_tags": [
            -100,
            1,
            -1
          ],
          "style": [
            -100,
            0,
            1
          ]
        }
      }
    }
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getGatewayHealth",
        "summary": "Gateway health, not bot liveliness",
        "responses": {
          "200": {
            "description": "Gateway serving",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Current allowlisted operations",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getBotDatabaseStatus",
        "summary": "RSStT database counters, no bot process claim",
        "responses": {
          "200": {
            "description": "Counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "DB unavailable"
          }
        }
      }
    },
    "/v1/feeds": {
      "get": {
        "operationId": "listFeeds",
        "summary": "Read-only feed metadata",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed records"
          }
        }
      }
    },
    "/v1/subscriptions": {
      "get": {
        "operationId": "listSubscriptions",
        "summary": "Read-only subscriptions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription records"
          }
        }
      }
    },
    "/v1/reviews": {
      "get": {
        "operationId": "listReviewMetadata",
        "summary": "Review queue excluding archived private article bodies",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review metadata"
          }
        }
      }
    },
    "/v1/rules": {
      "get": {
        "operationId": "getRules",
        "summary": "Current RSSPlus rules with redacted top-level secrets",
        "responses": {
          "200": {
            "description": "Rules and ETag",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rules/{channel_id}": {
      "put": {
        "operationId": "updateRules",
        "summary": "Opt-in atomic policy edit with If-Match; disabled unless operator enables",
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RulePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated config and new ETag"
          },
          "403": {
            "description": "Writes disabled"
          },
          "412": {
            "description": "ETag mismatch"
          },
          "428": {
            "description": "If-Match missing"
          }
        }
      }
    },
    "/v1/commands": {
      "post": {
        "operationId": "runNativeSubscriptionCommand",
        "summary": "Owner-only opt-in native subscription lifecycle and settings operations",
        "description": "Subscription CRUD plus set_title/set_hashtags/set_interval/set_length_limit/set_option, with strict schema and explicit channel allowlist; writes occur only inside running RSStT process via Unix IPC. No arbitrary field changes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeSubscriptionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native RSStT operation applied"
          },
          "400": {
            "description": "Invalid or unsupported operation"
          },
          "403": {
            "description": "Write gate disabled or channel not approved"
          },
          "404": {
            "description": "Subscription not found"
          },
          "409": {
            "description": "Subscription rejected or unchanged"
          },
          "503": {
            "description": "Bot IPC unavailable"
          }
        }
      }
    },
    "/v1/subscriptions/{subscription_id}/settings": {
      "get": {
        "operationId": "getNativeSubscriptionSettings",
        "summary": "Get allowed channel's subscription settings from read-only SQLite",
        "parameters": [
          {
            "in": "path",
            "name": "subscription_id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "channel_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Only allowlisted channel and matching subscription settings"
          },
          "400": {
            "description": "Missing or malformed channel"
          },
          "403": {
            "description": "Channel not allowlisted"
          },
          "404": {
            "description": "Subscription does not belong to target channel"
          }
        }
      }
    }
  }
}
